# ==========================================
# TÔ NO PIRAMBA - Variáveis de Ambiente
# ==========================================

# Backend & Database
PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tonopiramba?schema=public"

# JWT & Segurança
JWT_SECRET="pirambeira-super-secret-key-2026-production-ready"
JWT_EXPIRES_IN="7d"

# Configurações de Estabelecimento Padrão (Pirambeira Bar)
DEFAULT_RESTAURANT_SLUG="pirambeira"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
