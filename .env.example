# Copie as variáveis do backend para backend/.env. Não versione credenciais.
PORT=3001
NODE_ENV=development
# Supabase: pooler transacional para consultas; senha deve estar codificada na URL.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=5"
# Pooler de sessão para Prisma migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
FRONTEND_URL="http://localhost:3000"
PUBLIC_API_URL="http://localhost:3001/api"
# Frontend: colocar em frontend/.env.local antes do build.
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
