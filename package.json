{
  "name": "to-no-piramba-monorepo",
  "version": "1.0.0",
  "private": true,
  "pnpm": {
    "overrides": {
      "postcss": "8.5.23",
      "multer": "2.4.0",
      "deepmerge-ts": "8.0.0"
    }
  },
  "description": "Plataforma de comunidade social exclusiva para frequentadores de bares e restaurantes - Tô no Piramba",
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev": "pnpm --filter backend dev",
    "build:backend": "pnpm --filter backend build",
    "build:frontend": "pnpm --filter frontend build",
    "build": "pnpm --filter backend build && pnpm --filter frontend build",
    "lint:backend": "pnpm --filter backend lint",
    "lint:frontend": "pnpm --filter frontend lint",
    "lint": "pnpm --filter backend lint && pnpm --filter frontend lint",
    "test:backend": "pnpm --filter backend test",
    "test": "pnpm --filter backend test",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "pnpm --filter backend db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "social-network",
    "gastronomy",
    "nightlife",
    "nextjs",
    "nestjs",
    "prisma",
    "salvador",
    "pirambeira"
  ],
  "author": "Equipe Tô no Piramba",
  "license": "MIT"
}
